# LootPat Bazar — server-side configuration
#
# These values are consumed by the Qoder Sites Function (functions/index.ts) and
# the platform-managed database. Set them as Sites secrets in the dashboard —
# never commit real credentials, and never expose them to the frontend bundle.

# Fixed public HTTPS origin of the storefront (not a secret). Used for the
# second CSRF check and to decide whether cookies are Secure.
#   production: https://<your-site-domain>
#   local dev:  http://127.0.0.1:5173
APP_ORIGIN=

# One-time setup token for POST /api/setup. Generate a long random value, run the
# setup request once, then rotate or remove it.
SETUP_TOKEN=

# Session security
SESSION_SECRET=

# Payment mode: "sandbox" (default) or "live".
# Sandbox needs no gateway credentials: the local pay page completes a
# signed provider event through the same settlement path as real webhooks.
# Gateway on/off switches live in the database and are owner-only; only
# credentials belong here.
PAYMENTS_MODE=sandbox

# Shared HMAC secret for gateway webhooks. The signature input is
# "<unix seconds>.<raw body>"; requests older than five minutes are rejected.
# A per-provider override is also accepted: BKASH_WEBHOOK_SECRET,
# NAGAD_WEBHOOK_SECRET, SSLCOMMERZ_WEBHOOK_SECRET.
WEBHOOK_SECRET=

# bKash (live only)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad (live only)
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=

# SSLCommerz (live only). Card data is never read, stored or forwarded.
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Courier adapters (optional). "manual" always works without credentials;
# a courier appears as automatic only when both its URL and key are set.
PATHAO_API_URL=
PATHAO_API_KEY=
REDX_API_URL=
REDX_API_KEY=
STEADFAST_API_URL=
STEADFAST_API_KEY=

# SMS notifications (optional). With none of these set, messages are written to
# the sms_log table instead of being sent.
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Email adapter (optional). Without credentials, campaigns record the email
# audience but nothing is sent.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# The /admin IP allowlist is a database setting, not an environment variable:
# set it from /admin/security (security.admin_ip_allowlist).
